{
  "name": "ServiceRequest",
  "type": "object",
  "properties": {
    "request_number": {
      "type": "string"
    },
    "applicant_name": {
      "type": "string"
    },
    "national_id": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "governorate": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "service_type": {
      "type": "string"
    },
    "service_label": {
      "type": "string"
    },
    "details": {
      "type": "object",
      "additionalProperties": true
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "reviewing",
        "approved",
        "rejected",
        "info_requested",
        "completed"
      ],
      "default": "new"
    },
    "admin_notes": {
      "type": "string"
    },
    "submitted_at": {
      "type": "string"
    },
    "last_update": {
      "type": "string"
    },
    "audit_log": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string"
          },
          "at": {
            "type": "string"
          },
          "by": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "request_number",
    "applicant_name",
    "service_type"
  ]
}